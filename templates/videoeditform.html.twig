<VideoEditForm>
<div id="SmplVideoEditForm" class="smpl_window_form ui-draggable ui-draggable-handle">
	<form id="SmplVideoEditForm" method="{{ method }}">
		<input id="SmplVidId" type="hidden" value="0"/>	
		<div class="smpl_pop_title">
			<h3>{{ Edit }}: <div id="SmplVidFilename" class="smpl_imgedit_filename">Filename</div></h3>
				<button id="SmplVidClose" onclick="return false;" class="smpl_close{{ icon }} smpl_button right_corner" title="{{ Close }}">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</button>
		</div>
		<div id="SmplVidEditProps" class="smpl_edit_props">
		  <span id="SmplVidFilesize"></span> | 
		  <span id="SmplVidSize"></span> | 
		  {{ Last modified }}: <span id="SmplVidModified"></span> |
			<span id="smpl_ffmpegversion" class="smpl"> FFMpeg Version: {{ FFMpegVersion }}</span>	<br />			
		</div>		
		<div id="smpl_videdit_buttons" class="smpl_edit_props">
			Stack:
			<input id="SmplVidIdx" class="smpl_readonly smpl_step smpl_input_narrow" readonly="readonly" type="text" value="0"> /
			<input id="SmplVidQue" class="smpl_readonly smpl_que smpl_input_narrow" readonly="readonly" type="text" value="0">
			<button id="SmplVidInit" onclick="return false;" class="smpl_init{{ icon }} smpl_button" title="{{ Initial }}" disabled="disabled">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</button>		
			<button id="SmplVidPrev" onclick="return false;" class="smpl_undo{{ icon }} smpl_button" title="{{ Undo }}" disabled="disabled">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</button>
			<button id="SmplVidNext" onclick="return false;" class="smpl_redo{{ icon }} smpl_button" title="{{ Redo }}" disabled="disabled">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</button>
			<button id="SmplVidSave" onclick="return false;" class="smpl_save{{ icon }} smpl_button" title="{{ Save }}" disabled="disabled">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</button>
			<button id="SmplVidSaveAs" onclick="return false;" class="smpl_saveas{{ icon }} smpl_button" title="{{ Save As }}" disabled="disabled">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</button>
			<div id="smpl_vidsaveas">
				<input id="SmplVidSaveAsInput" type="text" class="smpl_text_output" val="">				
				<button id="SmplVidSaveAsOK" onclick="return false;" class="smpl_saveas{{ icon }} smpl_button" title="{{ Save As }}">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</button>
				<button id="SmplVidSaveAsCancel" onclick="return false;" class="smpl_cancel{{ icon }} smpl_button" title="{{ Cancel }}">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</button>
			</div>
			<button id="SmplVidCancel" onclick="return false;" class="smpl_cancel{{ icon }} smpl_button" title="{{ Cancel }}">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</button>			
		</div>
		
		<div id="smpl_video2mp4" class="smpl_edit_props">			
			<div>			  
				{{ Framerate }}:&nbsp;<input id="SmplVidFramerate" class="smpl_input_narrow" type="number" min="1" max="120" title="Framerate of the video">&nbsp; &nbsp;
				{{ Group of Pictures }}:&nbsp;<input id="SmplVidGOP" class="smpl_input_narrow" type="number" min="1" max="20" title="GOP=The number of frames between two I-frames. A common standard is 1–2 seconds long (e.g., at 30 fps, a GOP size of 30 or 60)" alt="GOP=The number of frames between two I-frames. A common standard is 1–2 seconds long (e.g., at 30 fps, a GOP size of 30 or 60)"> sec
				Video {{ bitrate }}:&nbsp;<input id="SmplVidBitrate" class="smpl_input_mid" type="number" min="0" title="Video bitrate in Kilo bit per second. If it is 0 then video quality remqains the same.">&nbsp;Kbps&nbsp;
				Audio {{ bitrate }}:&nbsp;<input id="SmplVidAudioBitrate" class="smpl_input_mid" type="number" min="1" max="640" title="Audio bitrate in Kilo bit per second. Default 256.">&nbsp;Kbps&nbsp;
			</div>
			<div>
				{{ Format }}:&nbsp;<select id="SmplVidFormat">
					<option value="original" selected>{{ Original }}</option>
					<option value="mp4">MP4</option>
					<option value="webm">WEBM</option>
					<option value="ogg">OGG</option>
					</select>
			
			
				{{ width }}:&nbsp;<input id="SmplVidWidth" type="number" class="smpl_input_mid" value="640" min="160" >&nbsp;
				{{ height }}:&nbsp;<input id="SmplVidHeight" type="number" class="smpl_input_mid" value="480" min="120">&nbsp;
				{{ Constrain_aspect_ratio }}:&nbsp;<input type="checkbox" id="SmplVidAspect" checked="checked">&nbsp;				
			</div>
			<div>
				{{ Clip start }}:&nbsp;<input id="SmplVidStart" type="number" class="smpl_input_mid" value="0" min="0" step="0.01">&nbsp;sec&nbsp;
				{{ Clip end }}:&nbsp;<input id="SmplVidEnd" type="number" class="smpl_input_mid" value="0" min="0" max="" step="0.01">&nbsp;sec&nbsp;
				{{ Clip duration }}:&nbsp;<input id="SmplVidDuration" type="text" class="smpl_input_mid" value="0" readonly="readonly">&nbsp;sec&nbsp;<br />
				{{ Rotate }}:&nbsp;<select id="SmplVidRotate">
					<option value="0" selected>-</option>
					<option value="90">{{ Right }} 90°</option>
					<option value="180">180°</option>
					<option value="270">{{ Left }} 90°</option>
				</select>
				&nbsp;{{ Extension }}:				
				{{ to original }} <input type="radio" id="SmplVidExtOrig" name="SmplVidExt" checked="checked" value="original">&nbsp;
				{{ to mp4 }} <input type="radio" id="SmplVidExtMp4" name="SmplVidExt" value="mp4">&nbsp;
			</div>
			<div class="smpl_edit_props" style="width: 100%;">
			{{ FFMpeg parameters }} (default): 			
			<textarea id="SmplVidParams" type="text" placeholder="-qscale 0" title="Other ffmpeg parameters, split by space or any other separation parameters, split by space or any other separation characters. For example: -qscale 0">
			</textarea>
			</div>
			<div class="smpl_edit_props">
				<label class="smpl" for="SmplVidConvert">{{ Video convert }}</label>
				<button id="SmplVidConvert" name="SmplVidConvert" onclick="return false;" class="smpl_convert{{ icon }} smpl_button" title="{{ Video convert }}">&nbsp;&nbsp;&nbsp;&nbsp;</button>				
			</div>
			
			<video id="SmplPlayer" controls="controls" src=""></video>
	</form>

	<div id="smpl_error" class="smpl_error ui-draggable ui-draggable-handle">
		<div id="smpl_error_close" class="smpl_help_close{{ icon }}">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</div>
		<div id="smpl_error_content">Error</div>
	</div>
</div>
</VideoEditForm>
