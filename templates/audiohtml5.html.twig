<div id="smpl{{ id }}" class="smpl_item_container {{ smpl_last_item_container }} {{ test }}" {{ importance }}>
	<div id="smpldiv{{ id }}" class="smpl_item_div smpl_type_audiohtml5">
		<audio id="smplaudio{{ id }}" controls="" class="smpl_audiohtml5">
			<source src="{{ src }}" type="{{ mime }}">
			Your browser does not support the audio tag.
		</audio>
	</div>
	<div class="smploth">
		<div id="DescCont{{ id }}">
			<a id="Desca{{ id }}" class="smpl_desc_a" href="javascript:void(0)">{{ ShowProperties }}</a>
			<div id="DescSub{{ id }}" class="smpl_desc_info {{ test }}">
			  <div id="Exif{{ id }}"></div>
			</div>	
		</div>
		<div class="smpl_buttons">
			<Edit>
				<AudEdit>
					<button id="AudBtn{{ id }}" class="smpl_button smpl_audedit{{ icon }} {{ test }}" data-imgbtn="{{ test }}" onclick="return false;" title="{{ Audio Edit }}">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</button>
				</AudEdit>
				<button id="SubBtn{{ id }}" class="smpl_edit{{ icon }} smpl_button"
					onclick="return false;" title="Caption / subscription {{ Edit }}">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</button>
				<button id="DelBtn{{ id }}" class="smpl_delete{{ icon }} smpl_button"
					onclick="return false;" title="{{ Delete }}">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</button>
			</Edit>
		</div>
		<div id="smpl_sub{{ id }}" class="smpl_subtitle">{{ subtitle }}
		</div>		
		<Link>
			<div id="smpl_link{{ id }}" class="smpl_link{{ smpl_url_class }}">
				<a href="{{ url }}" target="_blank">{{ Link }}</a>
			</div>
		</Link>
	</div>
</div>
