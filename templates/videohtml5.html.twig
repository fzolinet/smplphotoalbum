<div id="smpl{{ id }}" class="smpl_item_container {{ smpl_last_item_container }} {{ test }}" {{ importance }}>
	<div id="smpldiv{{ id }}" class="smpl_item_div smpl_type_videohtml5">
		<video id="smplvideo{{ id }}" controls="" class="smpl_videohtml5">
			<source src="{{ src }}">
			Your browser does not support the video tag.
		</video>
	</div>
	<div class="smploth">
		<div class="smpl_buttons">
			<Edit>
				<VidEdit>
					<button id="VidBtn{{ id }}" class="smpl_button smpl_videdit{{ icon }} {{ test }}" data-imgbtn="{{ test }}" onclick="return false;" title="{{ Video Edit }}">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</button>
				</VidEdit>
				<button id="SubBtn{{ id }}" class="smpl_button smpl_edit{{ icon }}"	onclick="return false;" title="Caption / subscription {{ Edit }}">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</button>
				<button id="DelBtn{{ id }}" class="smpl_button smpl_delete{{ icon }}" onclick="return false;" title="{{ Delete }}">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</button>
			</Edit>
		</div>
		<div id="smpl_sub{{ id }}" class="smpl_subtitle">{{ subtitle }}
		</div>		
		<Link>
			<div id="smpl_link{{ id }}" class="smpl_link{{ smpl_url_class }}">
				<a href="{{ url }}" target="_blank">{{ Link }}</a>
			</div>
		</Link>
		<div id="DescCont{{ id }}">
			<a id="Desca{{ id }}" class="smpl_desc_a" href="javascript:void(0)">{{ ShowProperties }}</a>						
			<div id="DescSub{{ id }}" class="smpl_desc_info">		
				<div id="Exif{{ id }}"></div>
			</div>
		</div>

	</div>
</div>
