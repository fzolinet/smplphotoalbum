<table class="smpl_exif_table">
  <tr class="smpl_exif_tr"><th class="smpl_exif_td">{{Video}}</th></tr>
  <tr class="smpl_exif_tr"><td class="smpl_exif_td">{{Title}}</td><td>{{title}}</td></tr>
  <tr class="smpl_exif_tr"><td class="smpl_exif_td">{{Artist}}</td><td>{{artist}}</td></tr>
  <tr class="smpl_exif_tr"><td class="smpl_exif_td">{{Data_format}}</td><td>{{dataformat}}</td></tr>
  <tr class="smpl_exif_tr"><td class="smpl_exif_td">{{Bitrate mode}}</td><td> {{bitrate_mode}}</td></tr>
  <tr class="smpl_exif_tr"><td class="smpl_exif_td">{{Total frames}})</td><td>{{total_frames}}</td></tr>
  <tr class="smpl_exif_tr"><td class="smpl_exif_td">{{Frame rate}}</td><td>{{frame_rate}} fps</td></tr> 
  <tr class="smpl_exif_tr"><td class="smpl_exif_td">{{Length}}</td><td>{{length}} sec</td></tr>
  <tr class="smpl_exif_tr"><td class="smpl_exif_td">{{Lossless}}</td><td>{{lossless}}</td></tr>
  <tr class="smpl_exif_tr"><td class="smpl_exif_td">{{Resolution X}}</td><td>{{resolution_x}}</td></tr>
  <tr class="smpl_exif_tr"><td class="smpl_exif_td">{{Resolution Y}}</td><td>{{resolution_y}}</td></tr>
  <tr class="smpl_exif_tr"><td class="smpl_exif_td">{{Codec}}</td><td>,{{codec}}</td></tr>
  <tr class="smpl_exif_tr"><td class="smpl_exif_td">{{Pixel Aspect Ratio}},{{pixel_aspect_ratio}}</td></tr>
</table>