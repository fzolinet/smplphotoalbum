<!-- Folder Form -->
<div id="SmplFolderForm" class="smpl_window_form ui-draggable ui-draggable-handle">
	<form id="SmplFolderForm" name="SmplFolderForm" METHOD="post">
		<div id="SmplFolderFormInner">			
			<div class="smpl_pop_title">
				<h3>{{ New folder }}</h3>
				<button id="SmplFolderClose" name="SmplFolderClose" class="smpl_close{{ icon }} smpl_button right_corner" title="{{ Close }}">&nbsp;&nbsp;&nbsp;&nbsp;</button>					
				<button id="SmplFolderSubmit" name="SmplFolderSubmit" class="smpl_save{{ icon }} smpl_button right_corner" title="{{ Save }}" value="SmplNewFolderSubmit">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</button>
			</div>
			<table id="SmplNewFolderTable">
				<tr>
					<th colspan='2'>{{ Name }}</th>
					<th>{{ Value }}</th>
				</tr>
				<tr>
					<th colspan='2' align="left">{{ Foldername }}</th>
					<td align="left">
						<input type='text' id="SmplFolderName" name="SmplFolderName" value="" size="45" maxlength="255" title="Name of folder. Can not use dot, slash, backslash, space characters and js code in the name of folder!" alt="Name of folder"/>
					</td>
				</tr>
				<tr>
					<th colspan='2' align="left">{{ Created }} | {{ Modified }}</th>
					<td align="left"><input type='text' id="SmplFolderTime" name="SmplFolderTime" value="" readonly="readonly" />&nbsp;						
					</td>
				</tr>					
				<tr>
					<th colspan='2' align="left">{{ Description }}</th>
					<td align="left"><input type='text' id="SmplFolderSubtitle" name="SmplFolderSubtitle" value="" size="45" maxlength="255"/>&nbsp;						
					</td>
				</tr>
			</table>
		</div>
	</form>
</div>
<!-- Folder Form -->
