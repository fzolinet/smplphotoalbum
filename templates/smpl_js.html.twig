  clipend   = 0;          // End time of clip
  video_aspect_ratio = 1; // Aspect ratio of video
  ofilesize = "";
  oframerate = 0;
  ogop = 0; 
  oclippstart = 0;
  oclipend = 0;
  oduration = 0;
