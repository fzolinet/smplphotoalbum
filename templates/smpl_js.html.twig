  oheight = 0;
  owidth = 0;
  ofilesize = "";
  oGOP = 0;  
  pars = "";
  rgbcolor = "#808080"; 
  signurl = "";  // sign file url  
  tempurl = "";  // Original temp path
  //timer = "0%";  // Timer text variable
  coounter = false;
  translateX = 0.0;
  translateY = 0.0;  
  test = false;
  testmsg = "";
  url = "";
  view = "";
  width = 0;
  wm = true;
  wmpath = "{{ wmpath }}";
  confirm = false;
  words = new Words();
  
  //Video Edit variables
  videoeditform = false;  // visible video edit form
  videosaved = false; // Saved the edted video file
  duration  = 0;          // Duration of video
  framerate = 0;          // Framerate of video
  gop       = 2;          // Group of Pictures (GOP) of video
