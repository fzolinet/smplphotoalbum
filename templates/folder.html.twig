<div id="smpl{{ id }}" class="smpl_item_container {{ smpl_last_item_container }} {{ test }}">
	<div id="smpldiv{{ id }}" class="smpl_item_div smpl_type_folder">
		<a id="smpla{{ id }}" href="{{ href }}" class="smpl_a" title="{{ title }}"> 
			<img id="smpltn{{ id }}" class="smpl_item" src="{{ linktn }}" title="{{ title }}" alt="{{ subtitle }}" loading="lazy" />
		</a>
	</div>
	<div class="smploth">
		<div id="smpl_sub{{ id }}" class="smpl_subtitle">{{ subtitle }}</div>		
		<Link>
			<div id="smpl_link{{ id }}" class="smpl_link{{ smpl_url_class }}">
				<a href="{{ url }}" target="_blank">{{ Link }}</a>
			</div>
		</Link>
		<div id="DescCont{{ id }}">
			<a id="Desca{{ id }}" class="smpl_desc_a" href="javascript:void(0)">{{ ShowProperties }}</a>
			<div id="DescSub{{ id }}" class="smpl_desc_info">
				<div class="smpl_desc_title">{{ desc }}</div>
				<div id="DescTime{{ id }}">{{ Last modified }}: {{ lastmodified }}</div>				
			</div>
		</div>
		<div class="smpl_buttons">
			<Edit>
				<button id="SubBtn{{ id }}" class="smpl_button smpl_edit{{ icon }}" onclick="return false;" title="{{ Caption Edit }}">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</button>
				<button id="DelBtn{{ id }}" class="smpl_button smpl_delete{{ icon }}" onclick="return false;" title="{{ Delete }}">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</button>
			</Edit>
		</div>	
	</div>	
</div>