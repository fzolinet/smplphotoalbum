<table class="smpl_exif_table">
  <tr class="smpl_exif_tr"><th class="smpl_exif_td">{{Audio}}</th></tr>
  <tr class="smpl_exif_tr"><td class="smpl_exif_td">{{Artist}}</td><td>{{comments_html}}</td></tr>
  <tr class="smpl_exif_tr"><td class="smpl_exif_td">{{Title}}</td><td>{{title}}</td></tr>
  <tr class="smpl_exif_tr"><td class="smpl_exif_td">{{Playtime}}</td><td>{{playtime_string}} sec</td></tr>
  <tr class="smpl_exif_tr"><td class="smpl_exif_td">{{Sample Rate}}</td><td> {{sample_rate}}</td></tr>
  <tr class="smpl_exif_tr"><td class="smpl_exif_td">{{Bitrate}})</td><td>{{bitrate}}</td></tr>
  <tr class="smpl_exif_tr"><td class="smpl_exif_td">{{Frame rate}}</td><td>{{frame_rate}} fps</td></tr> 
  <tr class="smpl_exif_tr"><td class="smpl_exif_td">{{Bitrate mode}}</td><td>{{bitrate_mode}} sec</td></tr>
  <tr class="smpl_exif_tr"><td class="smpl_exif_td">{{Bits per sample}}</td><td>{{bits_per_sample}}</td></tr>
  <tr class="smpl_exif_tr"><td class="smpl_exif_td">{{Channelmode}}</td><td>{{channelmode}}</td></tr>
  <tr class="smpl_exif_tr"><td class="smpl_exif_td">{{Channels}}</td><td>{{channels}}</td></tr>
  <tr class="smpl_exif_tr"><td class="smpl_exif_td">{{Codec}}</td><td>{{codec}}</td></tr>
  <tr class="smpl_exif_tr"><td class="smpl_exif_td">{{Compression ratio}}</td><td>,{{compression_ratio}}</td></tr>
  <tr class="smpl_exif_tr"><td class="smpl_exif_td">{{Compression mode}}</td><td>{{lossless}}</td></tr>
  <tr class="smpl_exif_tr"><td class="smpl_exif_td">{{'Dataformat}}</td><td>{{dataformat}}</td></tr>
  <tr class="smpl_exif_tr"><td class="smpl_exif_td">{{Encoder}}</td><td>{{encoder}}</td></tr>
</table>