<!-- UploadForm -->
<div id="SmplUploadForm" class="smpl_upload_form">
	<form id="SmplUploadForm" name="SmplUploadForm" METHOD="post" enctype="multipart/form-data">
		<div id="SmplUploadFormInner">
			<input id="smpl_uid" type="hidden" name="smpl_uid" value="SmplUploadForm" />
			<div class="smpl_upload_title">
				{{ Upload }} - <font color="red">Under Construction!!!</font>
				<button id="SmplUploadClose" name="SmplUploadClose" class="smpl_close{{ icon }} smpl_button right_corner" title="{{ Close }}">&nbsp;&nbsp;&nbsp;&nbsp;</button>					
				<button id="SmplUploadSubmit" name="SmplUploadSubmit" class="smpl_save{{ icon }} smpl_button right_corner" title="{{ Save }}" value="SmplUploadSubmit">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</button>
			</div>
			<table id="SmplUploadTable">
				<tr>
					<th colspan='2'>{{ Name }}</th>
					<th>{{ Value }}</th>
				</tr>
				<tr>
					<td colspan='2' align="left" valign="top"><label class="smpl" for="smpl_uname">{{ Filename }}</label></td>
					<td align="left" valign="top">
						<input type='file' id="smpl_uname" name="smpl_uname" value="" size="50" maxlength="255" />
					</td>
				</tr>
				<tr>
					<td colspan='2' align="left" valign="top"><label class="smpl" for="smpl_usize">{{ Size }}</label></td>
					<td align="left" valign="top"><input type='number' id="smpl_usize" name="smpl_usize" value="" readonly="readonly" />&nbsp;bytes&nbsp;						
					</td>
				</tr>
				<tr>
					<td colspan='2' align="left" valign="top"><label class="smpl" for="smpl_utime">{{ Modified }}</label></td>
					<td align="left"><input type='text' id="smpl_utime" name="smpl_utime" value="" readonly="readonly" />&nbsp;						
					</td>
				</tr>					
				<tr>
					<td colspan='2' align="left" valign="top"><label class="smpl" for="smpl_usub">{{ Subtitle }}</label></td>
					<td align="left" valign="top"><input type='text' id="smpl_usub" name="smpl_usub" value="" size="50" maxlength="255"/>&nbsp;						
					</td>
				</tr>
				<tr>
					<td colspan='2' align="left" valign="top"><label class="smpl" for="smpl_utype">{{ Type }}</label></td>
					<td align="left" valign="top">
						<select id="smpl_utype" name="smpl_utype">
							<option value="image" selected="selected">{{ Image }}</option>
							<option value="audio">{{ Audio }}</option>
							<option value="audiohtml5">{{ Audio }} ({{ HTML5 }})</option>
							<option value="video">{{ Video }}</option>
							<option value="videohtml5">{{ Video }} ({{ HTML5 }})</option>
							<option value="app">{{ Application }}</option>
							<option value="cmp">{{ Compressed }}</option>
							<option value="doc">{{ Document }}</option>
							<option value="other">{{ Other }}</option>
						</select>
					</td>
				</tr>
				<tr>
					<td colspan='2' align="left" valign="top"><label class="smpl" for="smpl_uimportance">{{ Importance }}</label></td>
					<td align="left" valign="top">
						<input id="smpl_uimportance" name="smpl_uimportance" type="number" value="0" min="-255" max="255">
					</td>
				</tr>
				<tr>
					<td colspan='2' align="left" valign="top"><label class="smpl" for="smpl_ulink">{{ Url }}</label></td>
					<td align="left" valign="top"><input id="smpl_ulink" type='text' name="smpl_ulink" value="" size="50" maxlength="255"/></td>
				</tr>
			</table>
		</div>
	</form>
</div>
<!-- UploadForm -->
