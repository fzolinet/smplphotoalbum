<ImgEditForm>
<div id="SmplImgEditForm" class="smpl_window_form ui-draggable ui-draggable-handle">
	<form id="SmplImgEditForm" name="SmplImgEditForm" METHOD="{{ method }}">
		<input id="smpl_imgedit_id" type="hidden" value="0" name="smpl_img_edit_id" />	
		<div class="smpl_pop_title">
			<h3>{{ Edit }}:	<div id="smpl_imgedit_filename" class="smpl_imgedit_filename">Filename</div></h3>
			<button name="SmplImgClose" id="SmplImgClose" onclick="return false;" class="smpl_close{{ icon }} smpl_button right_corner" title="{{ Close }}">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</button>
		</div>
		<div id="smpl_imgedit_props" class="smpl_edit_props">
		  <span id="smpl_imgedit_filesize"></span> | 
		  <span id="smpl_imgedit_size"></span> | 
		  {{ Last modified }}: <span id="smpl_imgedit_modified"></span> 
		</div>

		<div id="smpl_imgedit_buttons">
			Stack:
			<input id="smpl_step" class="smpl_readonly smpl_step smpl_input_narrow" readonly="readonly" type="text" value="0"> /
			<input id="smpl_que" class="smpl_readonly smpl_que" readonly="readonly" type="text" value="0">
			<button name="SmplImgInit" id="SmplImgInit" onclick="return false" class="smpl_init{{ icon }} smpl_button" title="{{ Initial }} image" disabled="disabled">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</button>
			<button name="SmplImgUndo" id="SmplImgUndo" onclick="return false;" class="smpl_undo{{ icon }} smpl_button" title="{{ Undo }}" disabled="disabled">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</button>
			<button name="SmplImgRedo" id="SmplImgRedo" onclick="return false;" class="smpl_redo{{ icon }} smpl_button" title="{{ Redo }}" disabled="disabled">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</button>
			<button name="SmplImgSubmit" id="SmplImgSubmit" onclick="return false;" class="smpl_save{{ icon }} smpl_button" title="{{ Save }}" disabled="disabled">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</button>
			<button name="SmplImgSaveAs" id="SmplImgSaveAs" onclick="return false;" class="smpl_saveas{{ icon }} smpl_button" title="{{ Save As }}" disabled="disabled">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</button>
			<div id="smpl_imgsaveas">
				<input id="SmplImgSaveAsInput" name="smpl_imgsaveas_input" type="text" class="smpl_text_output" val="">
				<button id="SmplImgSaveAsOK" name="SmplImgSaveAsOK" onclick="return false;" class="smpl_saveas{{ icon }} smpl_button" title="{{ Save As }}">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</button>
				<button id="SmplImgSaveAsCancel" onclick="return false;" class="smpl_cancel{{ icon }} smpl_button" title="{{ Cancel }}">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</button>
			</div>
			<button name="SmplImgCancel" id="SmplImgCancel" onclick="return false;" class="smpl_cancel{{ icon }} smpl_button" title="{{ Cancel }}">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</button>
			<span>Time:&nbsp;<input id="smpl_time" type="text" class="smpl_input_wide smpl_readonly smpl_text_output" readonly="readonly" value=""> sec</span>
			<span id="smpl_graphicversion" class="smpl">
				<select id="smpl_gdriver" class="smpl_dropdown" {{ greadonly }}>
					<option value="gd" {{ gdselected }}>{{ GDVersion }}</option>
					<option value="imagick" {{ imagickselected }}>{{ ImagickVersion }}</option>
				</select>
			</span>
			<img id="smpl_glogo" src="{{ glogo }}" alt="Graphic driver logo" title="Graphic driver logo" class="smpl_graphic_logo"/>
			<!-- Autoclose: <input id="smpl_autoclose" name="smpl_autoclose" type="checkbox" {{ autoclose }}>  -->
		</div>
		<!--  Point layer area -->
		<div id="smpl_point_area">
			{{ Point }}&nbsp;
			x:&nbsp;<input id="smpl_xp" type="number" class="smpl_input_wide" value="">
			y:&nbsp;<input id="smpl_yp" type="number" class="smpl_input_wide" value="">&nbsp;
			{{ Color }}&nbsp;<input id="smpl_rgbcolor" type="color" value="#000000" title="RGB color to fill">&nbsp;
			R&nbsp;<input id="smpl_r" type="number" class="SmplInputNarrow" step="1" min="-255" max="255" value="0" title="Red component: -255..+255" >
			G&nbsp;<input id="smpl_g" type="number" class="SmplInputNarrow" step="1" min="-255" max="255" value="0" title="Green component: -255..+255">
			B&nbsp;<input id="smpl_b" type="number" class="SmplInputNarrow" step="1" min="-255" max="255" value="0" title="Blue component: -255..+255">
			&alpha;&nbsp;<input id="smpl_alpha" class="SmplInputNarrow" type="number" step="1" min="0" max="100" value="10" title="Alpha: 0=opaque, 100=transparent">
			<button id="smpl_color_reset" onclick="return false;" class="smpl_reset{{ icon }} smpl_actbutton" title="Reset the settings of color parameters">{{ Reset }} {{ Color }}&nbsp;&nbsp;&nbsp;&nbsp;</button>
		</div>

		<nav id="smpl_imgedit_menu">
			<button id="smpl_enhance" onclick="return false;" class="smpl_enhance{{ icon }} smpl_label smpl_actbutton smpl_imagick" >{{ Enhance }}&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</button>
			<button id="smpl_add" onclick="return false;" class="smpl_add{{ icon }} smpl_label smpl_actbutton">{{ Add }}&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </button>
			<button id="smpl_geometry" onclick="return false;" class="smpl_geometry{{ icon }} smpl_label smpl_actbutton">{{ Geometry }}&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</button>
			<button id="smpl_lighting" onclick="return false;" class="smpl_lighting{{ icon }} smpl_label smpl_actbutton smpl_imagick">{{ Lighting }}&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</button>
			<button id="smpl_effect" onclick="return false;" class="smpl_effect{{ icon }} smpl_label smpl_actbutton">{{ Effect }}&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</button>
			<button id="smpl_color" onclick="return false;" class="smpl_color{{ icon }} smpl_label smpl_actbutton">{{ Color }}&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</button>
			<button id="smpl_specialeffect" onclick="return false;" class="smpl_spec{{ icon }} smpl_label smpl_actbutton">{{ Spec Effects }}&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</button>

			<div id="smpl_enhance_menu" class="smpl_menu">
				<button id="smpl_faceedit" onclick="return false;" class="smpl_label smpl_actbutton">{{ Face edit }}</button>
				<button id="smpl_redeye" class="smpl_label smpl_actbutton">{{ Red eye }}</button>
				<button id="smpl_repair" class="smpl_label smpl_actbutton">{{ Repair }}</button>
				<button id="smpl_skintune" class="smpl_label smpl_actbutton">{{ Skin tune }}</button>
			</div>

		
			<div id="smpl_add_menu" class="smpl_menu">
				<button id="smpl_watermark" class="smpl_label smpl_actbutton">{{ Watermark }}</button>
				<button id="smpl_vignette" class="smpl_label smpl_actbutton">{{ Vignette }}</button>
				<button id="smpl_border" class="smpl_label smpl_actbutton">{{ Border }}</button>
				<button id="smpl_bevel" class="smpl_label smpl_actbutton">{{ Bevel }}</button>
			</div>

			<div id="smpl_geometry_menu" class="smpl_menu">
				<button id="smpl_rotate" class="smpl_label smpl_actbutton">{{ Rotate }} / {{ Flip }}</button>
				<button id="smpl_crop" class="smpl_label smpl_actbutton">{{ Crop }}</button>
				<button id="smpl_resize" class="smpl_label smpl_actbutton">{{ Resize }}</button>
				<button id="smpl_shave" class="smpl_label smpl_actbutton">{{ Shave }}</button>
				<button id="smpl_perspective" class="smpl_label smpl_actbutton smpl_imagick">{{ Perspective }}</button>
				<button id="smpl_distortion" class="smpl_label smpl_actbutton smpl_imagick">{{ Distortion }}</button>
				<button id="smpl_lens" class="smpl_label smpl_actbutton smpl_imagick">{{ Lens }}</button>
				<button id="smpl_liquify" class="smpl_label smpl_actbutton smpl_imagick">{{ Liquify }}</button>
			</div>

			<div id="smpl_lighting_menu" class="smpl_menu">
				<button id="smpl_exposure" class="smpl_label smpl_actbutton">{{ Exposure }}</button>
				<button id="smpl_levels" class="smpl_label smpl_actbutton">{{ Levels }}</button>
				<button id="smpl_autolevels" class="smpl_label smpl_actbutton">{{ Auto }} {{ levels }}</button>
				<button id="smpl_lighteq" class="smpl_label smpl_actbutton">{{ Light EQ }}</button>
				<button id="smpl_dehaze" class="smpl_label smpl_actbutton">{{ Dehaze }}</button>
				<button id="smpl_dodgeburn" class="smpl_label smpl_actbutton">{{ Dodge }} / {{ Burn }}</button>
			</div>

			<div id="smpl_effect_menu" class="smpl_menu">
				<button id="smpl_grayscale" class="smpl_label smpl_actbutton" title="grayscale the image">{{ Grayscale }}</button>
				<button id="smpl_bw" class=" smpl_label smpl_actbutton" title="Black and White image">{{ B/W }}</button>
				<button id="smpl_white" class="smpl_label smpl_actbutton" title="White treshold above the color of pixel">{{ White }}</button>
				<button id="smpl_charchoal" class="smpl_label smpl_actbutton smpl_imagick" title="Charcoal (faszén)">{{ Charchoal }}</button>
				<button id="smpl_oil" class="smpl_label smpl_actbutton" title="Like oil painting">{{ Oil }}</button>
				<button id="smpl_sepia" class="smpl_label smpl_actbutton" title="Reddish brown color">{{ Sepia }}</button>
				<button id="smpl_blueshift" class="smpl_label smpl_actbutton" title="Yust like in moonlight">{{ Blue shift }}</button>
				<button id="smpl_solarize" class="smpl_label smpl_actbutton smpl_imagick" title="Light on the photo paper in photo darkroom">{{ Solarize }}</button>
				<button id="smpl_clahe" class="smpl_label smpl_actbutton smpl_imagick" title="Contrast Limited Adaptive Histogram Equalization">{{ CLAHE }}</button>				
			</div>

			<div id="smpl_color_menu" class="smpl_menu">
				<button id="smpl_histogram" class="smpl_label smpl_actbutton">{{ Histogram }}</button>
				<!-- <button id="smpl_equalize" class="smpl_label smpl_actbutton smpl_imagick">{{ Equalize }} {{ Histogram }}</button>-->
				<button id="smpl_whitebalance" class="smpl_label smpl_actbutton">{{ Whitebalance }}</button>
				<button id="smpl_normalize" class="smpl_label smpl_actbutton">{{ Normalize }}</button>
				<button id="smpl_gamma" class="smpl_label smpl_actbutton">{{ Gamma }}</button>
				<button id="smpl_brightness" class="smpl_label smpl_actbutton">{{ Brightness }}</button>
				<button id="smpl_rgb" class="smpl_label smpl_actbutton">{{ RGB }}</button>
				<button id="smpl_contrast" class="smpl_label smpl_actbutton">{{ Contrast }}</button>
			</div>

			<div id="smpl_specialeffect_menu" class="smpl_menu">
				<button id="smpl_noise" class="smpl_label smpl_actbutton">{{ Noise }}</button>
				<button id="smpl_sharp" class="smpl_label smpl_actbutton">{{ Sharpen }}</button>
				<button id="smpl_emboss" class="smpl_label smpl_actbutton">{{ Emboss }}</button>
				<button id="smpl_trim" class="smpl_label smpl_actbutton smpl_imagick">{{ Trim }}</button>
				<button id="smpl_edge" class="smpl_label smpl_actbutton" for="smpl_edge">{{ Edge }}</button>
				<button id="smpl_blur" class="smpl_label smpl_actbutton" for="smpl_blur">{{ Blur }}</button>
				<button id="smpl_convolution" class="smpl_label smpl_actbutton" for="smpl_convolution">{{ Convolution }}</button>
				<button id="smpl_wave" class="smpl_label smpl_actbutton" for="smpl_wave">{{ Wave }}</button>
				<button id="smpl_swirl" class="smpl_label smpl_actbutton" title="Swirl the points about the center of image">{{ Swirl }}</button>
			</div>
		</nav>

		<div class="smpl_imgedit_actions">
			<!-- Enhance Menu -->
			<div id="smpl_faceedit" class="smpl_imgedit_border">
				<button id="smpl_faceedit_done" onclick="return false;" class="smpl_actbutton">{{ Face Edit }}</button>
			</div>

			<div id="smpl_redeye" class="smpl_imgedit_border">
				<button id="smpl_redeye_done" onclick="return false;" class="smpl_actbutton">{{ Red eye }}</button>
			</div>

			<div id="smpl_repair" class="smpl_imgedit_border">
				<button id="smpl_repair_done" onclick="return false;" class="smpl_actbutton">{{ Repair }}</button>
			</div>

			<div id="smpl_skintune" class="smpl_imgedit_border">
				<button id="smpl_skintune_done" onclick="return false;" class="smpl_actbutton">{{ Skin tune }}</button>
			</div>

			<!-- Add Menu -->
			<div id="smpl_watermark" class="smpl_imgedit_border">
				<button id="smpl_watermark_done" onclick="return false;" class="smpl_actbutton">{{ Watermark }}</button>

				{{ Alpha }}&nbsp;<input type="number" id="smpl_watermark_alpha" name="smpl_wmalpha" class="SmplInputNarrow" min="0" max="100" value="50" title="Alpha:0..100, 0: opaque, 100: transparent"><br/>
				{{ Copyright }}&nbsp;<input id="smpl_watermark_copyright" name="smpl_copyright" class="smpl_input_text" value="{{ vcopyright }}" title="{{ This text saved into the Copyright IPTC/exif field of image only jpeg file }}">
				{{ Author }}&nbsp;<input id="smpl_watermark_author" name="smpl_author" class="smpl_input_text" value="{{ vauthor }}" title="{{ This text saved into the Author / owner IPTC field of image only jpeg file }}">
			</div>

			<div id="smpl_vignette" class="smpl_imgedit_border">
				<button id="smpl_vignette_done" class="smpl_actbutton" onclick="return false;">{{ Vignette }}</button>&nbsp;
				{{ Kind }}&nbsp;
				<select id="smpl_kind" class="smpl_dropdown">
					<option value="dark">{{ Darken }}</option>
					<option value="blur">{{ Blur }}</option>
				</select>
				{{ Size }}&nbsp;<input id="smpl_blursize" class="SmplInputNarrow" name="smpl_blursize" type="number" min="1" max="10000" step="1" value="50">
				<span class="smpl_deep">{{ Deep }}&nbsp;<input id="smpl_deep" class="SmplInputNarrow" name="smpl_deep" type="number" min="0" max="255" step="1" value="50"></span>
				{{ Geometry }}&nbsp;
				<select id="smpl_geom" class="smpl_dropdown">
					<option value="rect">{{ Rect }}</option>
					<option value="ellipse">{{ Ellipse }}</option>
					<option value="circle">{{ Circle }}</option>
				</select>&nbsp;
				<span id="smpl_vignette_blur" style="display: hide;">
					{{ Sigma }}&nbsp;<input id="smpl_blur_sigmav" class="SmplInputNarrow" type="number" step="0.1" min="1" max="10" value="1" title="1..10 pixel" />
					{{ Radius }}&nbsp;<input id="smpl_blur_radiusv" class="SmplInputNarrow" type="number" step="0.1" min="0.0" max="10" value="5" title="1..10 pixel, step: 0.1" />
				</span>
			</div>

			<div id="smpl_border" class="smpl_imgedit_border">
				<button id="smpl_border_done" onclick="return false;" class="smpl_actbutton" title="{{ Border }}">{{ Border }}</button>
				{{ Top }}&nbsp;<input id="smpl_border_top" type="number" class="SmplInputNarrow" min="0" max="50" value="3">&nbsp;
				{{ Inner }} {{ bevel }}&nbsp;<input id="smpl_border_innerbevel" type="number" class="SmplInputNarrow" min="0" max="50" value="3" title="Inner bevel">&nbsp;
				{{ Outer }} {{ bevel }}&nbsp;<input id="smpl_border_outerbevel" type="number" class="SmplInputNarrow" min="0" max="50" value="3" title="Outer bevel">
				{{ Height }}&nbsp;<input id="smpl_border_height" type="number" class="SmplInputNarrow" min="0" max="50" value="3" title="Height">
			</div>
			
			<div id="smpl_bevel" class="smpl_imgedit_border">
				<button id="smpl_bevel_done" onclick="return false;" class="smpl_actbutton" title="{{ Bevel }}">{{ Bevel }}</button>
				{{ Width }}&nbsp;<input id="smpl_bevel_width" type="number" class="SmplInputNarrow" min="0" value="10" title="Inner bevel">&nbsp;
				{{ Depht }}&nbsp;<input id="smpl_bevel_depht" type="number" class="SmplInputNarrow" min="1" max="50" value="1" title="Depht of bevel">
				{{ Direction }}&nbsp;<input id="smpl_bevel_direction" type="number" class="SmplInputNarrow" min="-180" max="180" value="0" title="Direction">
			</div>

			<!-- Geometry menu -->
			<div id="smpl_rotate" class="smpl_imgedit_border">
				<button id="smpl_autoorient_done" onclick="return false;" class="smpl_actbutton  smpl_imagick">{{ Auto orient }}</button>
				<button id="smpl_rotate_done" onclick="return false;" class="smpl_rotate{{ icon }} smpl_actbutton" title="{{ Rotate }}">{{ Rotate }}&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</button>
				<select id="smpl_rotate_deg" class="smpl_dropdown">
					<option value="0">-</option>
					<option value="-90" selected>{{ Left }} 90&deg;</option>
					<option value="90">{{ Right }} 90&deg;</option>
					<option value="180">180&deg;</option>
				</select>
				<input type="number" id="smpl_rotate_val" class="smpl_input_wide" min="-360" max="360" step="1" value="-90">&deg;
				<button id="smpl_flip_vertical_done" onclick="return false;" class="smpl_flip_vert{{ icon }} smpl_actbutton" title="{{ Flip vertical }}">{{ Flip vertically }}&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</button>
				<button id="smpl_flip_horizontal_done" onclick="return false;" class="smpl_flip_horiz{{ icon }} smpl_actbutton" title="{{ Flip horizontal }}">{{ Flip horizontally }}&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</button>
			</div>

			<div id="smpl_crop" class="smpl_imgedit_border">
				<button id="smpl_crop_done" onclick="return false;" class="smpl_actbutton">{{ Crop }}</button>
			</div>

			<div id="smpl_resize" class="smpl_imgedit_border">
				<button id="smpl_resize_done" onclick="return false;" class="smpl_actbutton">{{ Resize }}</button>
				<input type="range" id="smpl_resize_percent" class="smpl_slider" min="0" max="200" value="100">
				<input type="number" id="smpl_resize_percent_val"  class="smpl_input_wide" min="0">%&nbsp;
				<input type="number" id="smpl_resizew" value="0"  class="smpl_input_wide" min="0">&nbsp;x
				<input type="number" id="smpl_resizeh" value="0"  class="smpl_input_wide" min="0">px
			</div>

			<div id="smpl_shave" class="smpl_imgedit_border">
				<button id="smpl_shave_done" onclick="return false;" class="smpl_actbutton" title="Shaves pixels from the image edges">{{ Shave }}</button>
				Columns&nbsp;<input id="smpl_shave_cols" type="number" class="SmplInputNarrow"  min="0" max="255" value="10" title="Columns: 0-255">
				Rows&nbsp;<input id="smpl_shave_rows" type="number" class="SmplInputNarrow" min="0" max="255" value="10" title="Rows: 0..255">&nbsp;
			</div>

			<div id="smpl_perspective" class="smpl_imgedit_border">
				<button id="smpl_perspective_done" onclick="return false;" class="smpl_actbutton">{{ Perspective }}</button>
				{{ Transparent }}&nbsp;<input id="smpl_transparent_perspective" type="checkbox" class="smpl_actbutton" />&nbsp;
			</div>

			<div id="smpl_distortion" class="smpl_imgedit_border">
				<button id="smpl_distortion_done" onclick="return false;" class="smpl_actbutton">{{ Distortion }}</button><br />
				<table class="smpl_table">
					<tr>
						<td>{{ Horizontal Center }}</td>
						<td><input id="smpl_distortion_horizontal_center" type="range" class="smpl_slider" min="0" max="100" value="50" />
						&nbsp;<input id="smpl_distortion_horizontal_center_n" type="number" value="50">%</td>
					</tr>
					<tr>
						<td>{{ Vertical Center }}</td>
						<td><input id="smpl_distortion_vertical_center" type="range" class="smpl_slider" min="0" max="100" value="50" />
						&nbsp;<input id="smpl_distortion_vertical_n" type="number" value="50">%</td>
					</tr>
					<tr>
						<td>{{ Correction Strength }}</td>
						<td><input id="smpl_distortion_strength" type="range" class="smpl_slider"  min="0" max="100" value="50" />
						&nbsp;<input id="smpl_distortion_strength_n" type="number" value="50">%</td>
					</tr>
					<tr>
						<td>{{ Scale }}</td>
						<td><input id="smpl_distortion_scale" type="range" class="smpl_slider" min="1" max="200" value="100" />
						&nbsp;<input id="smpl_distortion_scale_n" type="number" value="50">%</td>
					</tr>
				</table>

				{{ Transparent }}&nbsp;<input id="smpl_transparent_distortion" type="checkbox" class="smpl_actbutton" />&nbsp;
				<select id="smpl_distortion_type" class="smpl_dropdown">
					<option value="barrel">{{ Barrel }}</option>
					<option value="pinchusion">{{ Pinchusion }}</option>
					<option value="fisheye">{{ Fisheye }}</option>
				</select><br />
			</div>

			<div id="smpl_lens" class="smpl_imgedit_border">
				A:&nbsp;<input id="smpl_lensA" type="number" class="SmplInputNarrow" min="-1.0" max="1.0" value="0.4" step="0.1" title="A: -1.0 - 1.0">
				B:&nbsp;<input id="smpl_lensB" type="number" class="SmplInputNarrow" min="-1.0" max="1.0" value="0.6" step="0.1" title="B: -1.0 - 1.0">
				C:&nbsp;<input id="smpl_lensC" type="number" class="SmplInputNarrow" min="-1.0" max="1.0" value="0.0" step="0.1" title="C: -1.0 - 1.0">
				D:&nbsp;<input id="smpl_lensD" type="number" class="SmplInputNarrow" min="-1.0" max="1.0" value="1.0" step="0.1" title="D: -2.0 - 2.0 >0: barrel, < 0 inverse barrel">
				{{ Bestfit }}&nbsp;<input id="smpl_lensbestfit" type="checkbox" checked="checked" class="smpl_actbutton">
				{{ Transparent }}&nbsp;<input id="smpl_transparent_lens" type="checkbox" class="smpl_actbutton" />&nbsp;
				<button id="smpl_lens_done" onclick="return false;" class="smpl_actbutton" title="Lens / Barrel">{{ Lens }}</button>
			</div>

			<div id="smpl_liquify" class="smpl_imgedit_border">
				<button id="smpl_liquify_done" onclick="return false;" class="smpl_actbutton">{{ Liquify }}</button>
			</div>

			<!-- Lighting Menu -->
			<div id="smpl_exposure" class="smpl_imgedit_border">
				<button id="smpl_exposure_done" onclick="return false;" class="smpl_actbutton">{{ Exposure }}</button>
			</div>

			<div id="smpl_levels" class="smpl_imgedit_border">
				<button id="smpl_levels_done" onclick="return false;" class="smpl_actbutton">{{ Levels }}</button>
			</div>

			<div id="smpl_autolevels" class="smpl_imgedit_border">
				<button id="smpl_autolevels_done" onclick="return false;" class="smpl_actbutton">{{ Auto }}{{ Levels }}</button>
			</div>

			<div id="smpl_lighteq" class="smpl_imgedit_border">
				<button id="smpl_lighteq_done" onclick="return false;" class="smpl_actbutton">{{ Light EQ }}</button>
			</div>

			<div id="smpl_dehaze" class="smpl_imgedit_border">
				<button id="smpl_dehaze_done" onclick="return false;" class="smpl_actbutton">{{ Dehaze }}</button>
			</div>

			<div id="smpl_dodgeburn" class="smpl_imgedit_border">
				<button id="smpl_dodge_done" onclick="return false;" class="smpl_actbutton">{{ Dodge }}</button><br/>
				<button id="smpl_burn_done" onclick="return false;" class="smpl_actbutton">{{ Burn }}</button>
			</div>

			<!-- Effect menu -->
			<div id="smpl_grayscale" class="smpl_imgedit_border">
				<button id="smpl_grayscale_done" onclick="return false;" class="smpl_actbutton">{{ Grayscale }}</button>
			</div>

			<div id="smpl_bw" class="smpl_imgedit_border">
				<button id="smpl_bw_done" onclick="return false;" class="smpl_actbutton">{{ B/W }}</button>
				Level&nbsp;<input id="smpl_bwlevel" name="smpl_bwlevel" type="number" class="SmplInputNarrow" title="Cut level. Below is black greater is white" min="0" max="100" value="50">
			</div>

			<div id="smpl_white" class="smpl_imgedit_border">
				<button id="smpl_white_done" onclick="return false;" class="smpl_actbutton">{{ White }}</button>
			</div>

			<div id="smpl_charchoal" class="smpl_imgedit_border">
				<button id="smpl_charchoal_done" onclick="return false;" class="smpl_actbutton">{{ Charchoal }}</button>
				Radius&nbsp;<input id="smpl_charchoalradius" type="number" class="SmplInputNarrow" title="Radius: 0..10" min="0" max="10" value="5">
				Sigma&nbsp;<input id="smpl_charchoalsigma" type="number" class="SmplInputNarrow" title="Sigma: 0..100" min="0" max="10" value="2">
			</div>

			<div id="smpl_oil" class="smpl_imgedit_border">
				<button id="smpl_oil_done" onclick="return false;" class="smpl_actbutton">{{ Oil }}</button>
				Radius&nbsp;<input id="smpl_oilradius" type="number" class="SmplInputNarrow" title="Most frequently in radius" min="0" max="10" value="5">
				Intensity level&nbsp;<input id="smpl_oilintlevel" type="number" class="SmplInputNarrow" title="Most intensity level" min="0" max="255" value="240">
			</div>

			<div id="smpl_sepia" class="smpl_imgedit_border">
				<button id="smpl_sepia_done" onclick="return false;" class="smpl_actbutton">{{ Sepia }}</button>
				Intensity level&nbsp;<input id="smpl_sepialevel" type="number" class="SmplInputNarrow" title="Sepia level. default: 80" min="0" max="255" value="80" />
			</div>

			<div id="smpl_blueshift" class="smpl_imgedit_border">
				<button id="smpl_blueshift_done" onclick="return false;" class="smpl_actbutton" title="Colors in the moonlight">{{ Blue shift }}</button>
				Intensity level&nbsp;<input id="smpl_blueshiftlevel" type="number" class="SmplInputNarrow" title="Blue shift level. default: 15" min="0" max="255" value="15" />
			</div>
			
			<div id="smpl_solarize" class="smpl_imgedit_border">
				<button id="smpl_solarize_done" onclick="return false;" class="smpl_actbutton" title="Light on the photo paper in photo dark room">{{ Solarize }}</button>
				Treshold level&nbsp;<input id="smpl_solarizetreshold" type="number" class="SmplInputNarrow" title="Solarize treshold. default: 50%" min="0" max="100" value="50" />%
			</div>
			
			<div id="smpl_clahe" class="smpl_imgedit_border">
				<button id="smpl_clahe_done" onclick="return false;" class="smpl_actbutton" title="Enhance Local Contrast">{{ CLAHE }}</button>
				Width&nbsp;<input id="smpl_clahewidth" type="number" class="SmplInputNarrow" title="Width:1..50. default: 10" min="1" max="50" value="10" />
				Height&nbsp;<input id="smpl_claheheight" type="number" class="SmplInputNarrow" title="Height:1..50. default: 10" min="1" max="50" value="10" />
				Bins number&nbsp;<input id="smpl_clahebins" type="number" class="SmplInputNarrow" title="Bins:1..50. default: 10" min="1" max="256" value="29" />
				Clip limit&nbsp;<input id="smpl_claheclip" type="number" class="SmplInputNarrow" title="clip limit:1..10000. default: 100" min="1" max="10000" value="100" />
			</div>

			<!-- Color menu -->
			<div id="smpl_histogram" class="smpl_imgedit_border">
				<button id="smpl_histogram_done" onclick="return false;" class="smpl_actbutton" title="get The histogram of image">{{ Histogram }}</button>
				{{ Auto histogram }}&nbsp;<input id="smpl_autohistogram" name="smpl_autohistogram" type="checkbox" title="When load, redo, undo the image it load the histogram too" />
			</div>

			<div id="smpl_equalize" class="smpl_imgedit_border">
				<button id="smpl_equalize_done" onclick="return false;" class="smpl_actbutton smpl_imagick" title="Equalize the histogram">{{ Equalize }} {{ Histogram }}</button>
			</div>

			<div id="smpl_whitebalance" class="smpl_imgedit_border">
				<button id="smpl_whitebalance_done" onclick="return false;" class="smpl_actbutton" title="Set whitebalance of image">{{ Whitebalance }}</button>
			  &nbsp;Mode&nbsp;
				<select id="smpl_whitebalance_mode" name="smpl_whitebalance_mode" class="smpl_dropdown">
					<option value="white">White patch</option>					
					<option value="gray">Gray World</option>					
				</select>
				&nbsp;Exclude (max / min)&nbsp;<input id="smpl_whitebalance_exclude" type="number" name="smpl_whitebalance_exclude" class="SmplInputNarrow" title="Exclude max & min %" min="0" max="50" value="0" />
			</div>

			<div id="smpl_normalize" class="smpl_imgedit_border">
				<button id="smpl_normalize_done" onclick="return false;" class="smpl_actbutton" title="Normalize the image">{{ Normalize }}</button>
				<select id="smpl_normalize_channel" title="Channel: Default, All, Red, Green, Blue, Alpha, " class="smpl_input_wide smpl_dropdown">
					<option value="default" selected>Default</option>
					<option value="all">All</option>
					<option value="r">Red</option>
					<option value="g">Green</option>
					<option value="b">Blue</option>
					<option value="alpha">Alfa</option>
				</select>&nbsp;
				<span class="smpl_gd">Mode:&nbsp;<input id="smpl_normalize_mode" name="mode" type="number" class="SmplInputNarrow" min="1"max="2" value="1" title="A normalizing mode">;
				&nbsp;Dynamic&nbsp;<input id="smpl_dynamica" name="dynamic" class="SmplInputNarrow" type="number" min='0' max='255' value='254' title="Dynamic range">
				</span>
			</div>

			<div id="smpl_gamma" class="smpl_imgedit_border">
				<button id="smpl_gamma_done" onclick="return false;" class="smpl_gamma{{ icon }} smpl_actbutton" title="Change the image in gray">{{ Gamma }}&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</button>&nbsp;
				{{ In }}&nbsp;<input id="smpl_gammain" type="range" min="0" max="4" step="0.1" value="2.2" class="smpl_slider">
				<div id="smpl_gammain_val" style="display: inline; width: 4em;">2.2</div>&nbsp;
				{{ Out }}&nbsp;<input id="smpl_gammaout" type="range" min="0" max="4" step="0.1" value="1.0" class="smpl_slider">
				<div id="smpl_gammaout_val" style="display: inline; width: 4em;">1.0</div>
				<span class="smpl_imagick">
					{{ Auto gamma }}&nbsp;<input id="smpl_autogamma" name="smpl_autogamma" type="checkbox" {{ autogamma }} />
				</span>
			</div>

			<div id="smpl_brightness" class="smpl_imgedit_border">
				<button id="smpl_brightness_done" onclick="return false;" class="smpl_brightness{{ icon }} smpl_actbutton" title="Set the brightness, saturation, hue of image.">{{ Brightness }}&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</button>&nbsp;
				<input id="smpl_brightness" type="number" class="SmplInputNarrow" step="1" min="-255" max="255" value="0" Title="Brightness: -255...+255, negative: darken, positiv: brighten">
				<button id="smpl_saturation_done" onclick="return false;" class="smpl_saturation{{ icon }} smpl_actbutton" title="Set saturation.">{{ Saturation }}&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</button>
				<input id="smpl_saturation" type="number" class="SmplInputNarrow" step="1" min="-255" max="255" value="0" Title="-255: grey...+255: colorfull">
				<button id="smpl_hue_done" onclick="return false;" class="smpl_hue{{ icon }} smpl_actbutton" title="Set hue: -180...+180 degree">{{ Hue }}&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</button><input id="smpl_hue" type="number" class="SmplInputNarrow" step="1" min="-180" max="180" value="0" Title="Hue: -180...+180 degree ">
			</div>

			<div id="smpl_rgb"  class="smpl_imgedit_border">
				<button id="smpl_rgb_done" onclick="return false;" class="smpl_rgb{{ icon }} smpl_actbutton" title="Set the color and alpha channel of image">{{ RGB }}&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</button>&nbsp;
			</div>

			<div id="smpl_contrast"  class="smpl_imgedit_border">
				<button id="smpl_contrast_done" onclick="return false;" class="smpl_actbutton" title="Set the contrast of image">{{ Contrast }}</button>
				<input id="smpl_contrast" type="number" class="SmplInputNarrow" step="1" min="-100" max="100" value="2" title="Contrast: -100..+100">
			</div>

			<!-- Detail menu -->
			<div id="smpl_noise" class="smpl_imgedit_border">
				<button id="smpl_addnoise_done" onclick="return false;" class="smpl_actbutton">{{ Add Noise }}</button>&nbsp;
				&nbsp;{{ Level }}&nbsp;
				<input id="smpl_noiselevel" class="SmplInputNarrow" type="number" step="1" min="1" max="100" value="10" title="Noise level: 1..100%">
				&nbsp;{{ Type }}&nbsp;
				<select id="smpl_noise_type" class="smpl_input_wide smpl_dropdown">
					<option value="uniform" selected>Uniform</option>
					<option value="laplacian">Laplacian</option>
					<option value="gaussian">Gaussian</option>
					<option value="multigauss" class="smpl_imagick">Multi gauss</option>
					<option value="impulse">Impulse</option>
					<option value="poisson">Poisson</option>
				</select>
				&nbsp;{{ Channel }}&nbsp;
				<select id="smpl_addnoise_channel" title="Channel: Red, Green, Blue, Alpha, All" class="smpl_input_wide smpl_dropdown">
					<option value="default" selected>Default</option>
					<option value="all">All</option>
					<option value="r">Red</option>
					<option value="g">Green</option>
					<option value="b">Blue</option>
					<option value="alpha">Alpha</option>
					<option value="opacity">Opacity</option>
				</select><br />
				<button id="smpl_denoise_done" onclick="return false;" class="smpl_actbutton">{{ Denoise }}</button>

				<select id="smpl_denoise_type" title="Imageick: Denoise, Enhance mage" class="smpl_input_wide smpl_dropdown">
					<option value="denoise" selected>Denoise</option>
					<option class="smpl_imagick" value="enhance">Enhance</option>
				</select>
				<input id="smpl_denoiselevel" type="number" class="SmplInputNarrow" step="1" min="1" max="100" value="4" title="Denoise level / Treshold: 1..100">&nbsp;
				<input id="smpl_softness" type="number" class="SmplInputNarrow smpl_imagick" step="1" min="0" max="100" value="0" title="Softness: 0.0 - none .. 100: noisy">&nbsp;
			</div>

			<div id="smpl_sharp" class="smpl_imgedit_border">
				<button id="smpl_sharp_done" onclick="return false;" class="smpl_actbutton">{{ Sharpen }}</button>&nbsp;
				<span class="smpl_imagick">
				Radius:<input id="smpl_sharp_radius" type="number"  class="SmplInputNarrow" min="0" max="10" value="2" title="Radius: 1..10. It should be larger than Sigma">&nbsp;
				Sigma:<input id="smpl_sharp_sigma" type="number"  class="SmplInputNarrow" min="0" max="10" value="1" title="Sigma: 1..10">&nbsp;</span>
				<span class="smpl_gd">Sharplevel:<input id="smpl_sharplevel" type="number"  class="SmplInputNarrow" min="1" max="32" value="1" title="Sharplevel: 1..32">&nbsp;</span>
			</div>

			<div id="smpl_emboss" class="smpl_imgedit_border">
				<button id="smpl_emboss_done" onclick="return false;" class="smpl_actbutton">{{ Emboss }}</button>
				<span class="smpl_imagick">
					Radius&nbsp;<input id="smpl_emboss_radius" type="number" class="SmplInputNarrow" step="0.01" min="0" max="10" value="1" title="Radius:1-10">
					Sigma&nbsp;<input id="smpl_emboss_sigma" type="number" class="SmplInputNarrow" step="0.01" min="0" max="10" value="1.16" title="Standard deviation in pixel:1-100">&nbsp;
				</span>
				<span class="smpl_gd">Embosslevel&nbsp;<input id="smpl_embosslevel" type="number" class="SmplInputNarrow" step="1" min="1" max="32" value="1" title="level:1..32"></span>
			</div>

			<span class="smpl_imagick">
				<div id="smpl_trim" class="smpl_imgedit_border">
					<button id="smpl_trim_done" onclick="return false;" class="smpl_actbutton" title="Remove edges that are the background color from the image">{{ Trim }}</button>
					Fuzz&nbsp;<input id="smpl_trimfuzz" type="number" class="SmplInputNarrow" step="0.01" min="0" max="1" value="0.1" title="Columns: 0-1">
				</div>
			</span>

			<div id="smpl_edge" class="smpl_imgedit_border">
				<button id="smpl_edge_done" onclick="return false;" class="smpl_actbutton">{{ Edge }}</button>
				Radius&nbsp;<input id="smpl_edge_radius" type="number" class="SmplInputNarrow" step="0.1" min="0" max="10" value="0" title="Radius/level: 1-10"><br/>
			</div>

			<div id="smpl_blur" class="smpl_imgedit_border">
				<button id="smpl_blur_done" onclick="return false;" class="smpl_actbutton">{{ Blur }}</button>&nbsp;
				<span class="smpl_imagick">
					Radius&nbsp;<input id="smpl_blur_radius" type="number" class="SmplInputNarrow" step="1" min="0" max="10" value="5" title="Radius:1..32, step: 0.1">
					Sigma&nbsp;<input id="smpl_blur_sigma" type="number" class="SmplInputNarrow" step="1" min="1" max="10" value="1" title="Standard deviation in pixel:1..32">
				</span>
				<span class="smpl_gd">Blurlevel&nbsp;<input id="smpl_blurlevel" type="number" class="SmplInputNarrow" step="1" min="1" max="32" value="1" title="Radius:1..32"></span>
				Type&nbsp;
				<select id="smpl_blurtype" class="smpl_input_wide smpl_dropdown" title="Simple blur, Adaptive blur, Gaussian blur, Motion blur">
					<option value="blur" selected>Blur</option>
					<option value="adaptiveblur" class="smpl_imagick">Adaptive</option>
					<option value="gaussianblur">Gaussian</option>
					<option value="motionblur" class="smpl_imagick">Motion</option>
				</select>
				<span class="smpl_imagick">
					&nbsp;Channel&nbsp;
					<select id="smpl_blur_channel" class="smpl_input_wide smpl_dropdown" title="Channel: Red, Green, Blue, Alpha, All">
						<option value="default" selected>Default</option>
						<option value="all">All</option>
						<option value="r">Red</option>
						<option value="g">Green</option>
						<option value="b">Blue</option>
						<option value="alpha">Alpha</option>
						<option value="opacity">Opacity</option>
					</select>
					<span id="smpl_blur_angle_visibility">
						&nbsp;Angle&nbsp;<input id="smpl_blur_angle" name="smpl_blur_angle" type="number"
						class="SmplInputNarrow" step="1" min="0" max="360" value="0" title="Angle: If the Motion blur:0-360, step: 0.1">
					</span>
				</span>
			</div>

			<div id="smpl_convolution" class="smpl_imgedit_border">
				<button id="smpl_convolution_done" onclick="return false;" class="smpl_actbutton">{{ Convolution }}</button>&nbsp;
				<select id="smpl_filters" class="smpl_input_wide smpl_dropdown">
					<option selected value="sharpen">{{ Sharpen }}</option>
					<option value="edge">{{ Edge }}</option>
					<option value="findedge">{{ Find edges }}</option>
					<option value="emboss">{{ Emboss }}</option>
					<option value="boxblur">{{ Box blur }}</option>
					<option value="gaussianblur">{{ Gaussian blur }}</option>
					<option value="unsharp">{{ Unsharp }}</option>
				</select>
				Norm&nbsp;<input id="smpl_convdiv"  type="number" class="SmplInputNarrow" step="0" min="-256" max="256" value="0">
				Offs&nbsp;<input id="smpl_convoffs" type="number" class="SmplInputNarrow" step="0" min="-256" max="256" value="0">
				Col&nbsp;<input id="smpl_convcolor" type="number" class="SmplInputNarrow" step="0" min="-256" max="256" value="0"><br />
				Matrix&nbsp;
				<table class="smpl_table" style="display:inline;">
					<tr>
						<td><input id="smpl_conva00" type="number" class="SmplInputNarrow" step="1" min="-3" max="16" value="0"></td>
						<td><input id="smpl_conva01" type="number" class="SmplInputNarrow" step="1" min="-16" max="16" value="0"></td>
						<td><input id="smpl_conva02" type="number" class="SmplInputNarrow" step="1" min="-16" max="16" value="0"></td>
					</tr>
					<tr>
						<td><input id="smpl_conva10" type="number" class="SmplInputNarrow" step="1" min="-16" max="16" value="0"></td>
						<td><input id="smpl_conva11" type="number" class="SmplInputNarrow" step="1" min="-16" max="16" value="0"></td>
						<td><input id="smpl_conva12" type="number" class="SmplInputNarrow" step="1" min="-16" max="16" value="0"></td>
					</tr>
					<tr>
						<td><input id="smpl_conva20" type="number" class="SmplInputNarrow" step="1" min="-16" max="16" value="0"></td>
						<td><input id="smpl_conva21" type="number" class="SmplInputNarrow" step="1" min="-16" max="16" value="0"></td>
						<td><input id="smpl_conva22" type="number" class="SmplInputNarrow" step="1" min="-16" max="16" value="0"></td>
					</tr>
				</table>
			</div>

			<div id="smpl_wave" class="smpl_imgedit_border">
					<button id="smpl_wave_done" onclick="return false;" class="smpl_actbutton" title="Change teh Image with waves">{{ Wave }}</button>
					Amplitude&nbsp;<input id="smpl_amplitude" type="number" class="SmplInputNarrow" step="1" min="0" max="20" value="5" title="Wave amplitude: 0..20">
					Length&nbsp;<input id="smpl_wavelength" type="number" class="SmplInputNarrow" step="1" min="0" max="200" value="20" title="Wavelength: 0..200">			
			</div>

			<div id="smpl_swirl" class="smpl_imgedit_border">
					<button id="smpl_swirl_done" onclick="return false;" class="smpl_actbutton" title="swirl the pixels abot the center of image">{{ Swirl }}</button>
					Angle&nbsp;<input id="smpl_angle" type="number" class="SmplInputNarrow" step="1" min="-3600" max="3600" value="90" title="Swirl angle: -3600..3600">&deg;
			</div>
		</div> 
		<!--  smpl_edit_actions div -->

		<!-- Distortion layer area -->
		<div id="smpl_dist_area" class="smpl_imgedit_border">
			{{ Target }}
			P1:&nbsp;x1:<input id="smpl_xd1" type="number" class="smpl_input_wide">
			&nbsp;y1:<input id="smpl_yd1" type="number" class="smpl_input_wide">
			P2:&nbsp;x2:<input id="smpl_xd2" type="number" class="smpl_input_wide">
			&nbsp;y2:<input id="smpl_yd2" type="number" class="smpl_input_wide"><br />
			P3:&nbsp;x3:<input id="smpl_xd3" type="number" class="smpl_input_wide">
			&nbsp;y3:<input id="smpl_yd3" type="number" class="smpl_input_wide">
			P4:&nbsp;x4:<input id="smpl_xd4" type="number" class="smpl_input_wide">
			&nbsp;y4:<input id="smpl_yd4" type="number" class="smpl_input_wide"><br />
						{{ Size }}: {{ Original }}:
			<input id="smpl_dwidth"  class="smpl_readonly smpl_input_wide" readonly="readonly" type="text">&nbsp;x&nbsp;
			<input id="smpl_dheight" class="smpl_readonly smpl_left smpl_input_wide" readonly="readonly" type="text">px
		</div>

		<!-- Rectangle layer area -->
		<div id="smpl_rect_area" class="smpl_imgedit_border">
			{{ Left top }}
			<input id="smpl_x1" type="number" class="smpl_input_mid">
			<input id="smpl_y1" type="number" class="smpl_input_wide">&nbsp;
			{{ Right bottom }}
			<input id="smpl_x2" type="number" class="smpl_input_wide" min="0">
			<input id="smpl_y2" type="number" class="smpl_input_wide" min="0">&nbsp;
			{{ Constrain_aspect_ratio }} <input type="checkbox" id="smpl_aspect">&nbsp;
			<button id="smpl_rect_reset" onclick="return false;" class="">{{ Reset }}</button><br />
			{{ Size }}: {{ Original }}:
			<input id="smpl_width"  class="smpl_readonly smpl_input_wide" readonly="readonly" type="text">&nbsp;x&nbsp;
			<input id="smpl_height" class="smpl_readonly smpl_left smpl_input_wide" readonly="readonly" type="text">px&nbsp;=>&nbsp;<span title="width x height in pixel and %"> {{ selected }}:</span>
			<input id="smpl_wh" class="smpl_readonly smpl_text_output" readonly="readonly"  value="0 x 0px" type="text" title="width x height in pixel">
			<input id="smpl_whp" class="smpl_readonly smpl_text_output" readonly="readonly"  value="0 x 0%" type="text" title="width x height in %">
		</div>

		<!-- Circle layer area -->
		<div id="smpl_circle_area" class="smpl_imgedit_border">
			{{ Circle }}
			&nbsp;x of center&nbsp<input id="smpl_x" type="number" class="smpl_input_wide">
			&nbsp;y of center&nbsp<input id="smpl_y" type="number" class="smpl_input_wide">&nbsp;
			&nbsp;radius&nbsp<input type="number" id="smpl_radius" class="smpl_input_wide"  min="0">
		</div>

		<!-- Grid Layer area -->
		<div id="smpl_grid_area" class="smpl_imgedit_border">
		{{ Show Grid }}&nbsp;<input id="smpl_grid" type="checkbox" class="smpl_actbutton">
		</div>

		<div id="SmplCanvasContainer">
			<canvas id="SmplCanvas" class="smpl_imgedit_img" width="400" height="300" class="smpl_canvas"></canvas>
		</div>

		<div id="smpl_zoom_area">
			&nbsp;Zoom enable/disable&nbsp;<input id="smpl_zoom_enable" type="checkbox" class="SmplInputNarrow smpl_actbutton" checked="checked"title="Zoom enable/disable">
			<input id="smpl_zoom" type="number" class="smpl_input_wide smpl_actbutton" min="10" max="10000" step="1" value="100" title="Zoom">%
			Restore original <button id="smpl_orig" class="smpl_actbutton" onclick="return false;">size & position</button>
		</div>

		<div id="smpl_histogram_area">
			{{ Histogram }}			  
			&nbsp;<img id="smpl_hist_r" class="smpl_hist_img" name="smpl_hist_r" src="">
			&nbsp;<img id="smpl_hist_g" class="smpl_hist_img" name="smpl_hist_g" src="">
			&nbsp;<img id="smpl_hist_b" class="smpl_hist_img" name="smpl_hist_b" src="">
		</div>
		
	</form>

	<div id="smpl_error" class="smpl_error ui-draggable ui-draggable-handle">
		<div id="smpl_error_close" class="smpl_help_close{{ icon }}">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</div>
		<div id="smpl_error_content">Error</div>
